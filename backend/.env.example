# ─────────────────────────────────────────────────────────────
# 백엔드 환경변수 템플릿
# 사용법: 이 파일을 복사해 `.env.development` (또는 `.env.production`) 을 만들고 값을 채우세요.
#   cp .env.example .env.development
# 로딩 규칙: shared 패키지가 APP_ENV(기본 development)에 따라 `.env.{APP_ENV}` → `.env` 순으로 로드.
# (`.env.*` 는 .gitignore 로 커밋 제외, `.env.example` 만 커밋됨)
# ─────────────────────────────────────────────────────────────

APP_ENV=development

# --- DB (PostgreSQL) ---
# 완전 로컬: localhost:5432 (docker-compose.dev.yml)
# 개발서버(미니PC) 사용: scripts/dev-db-tunnel.sh 실행 후 localhost:15432 로 변경
DATABASE_URL=postgresql+asyncpg://stock_user:stock_password@localhost:5432/stock_db
SYNC_DATABASE_URL=postgresql+psycopg2://stock_user:stock_password@localhost:5432/stock_db

# --- Redis (Celery 브로커 + SSE pub/sub + KIS 토큰 공유) ---
# 개발서버 DB를 쓰더라도 Redis 는 로컬 유지 권장(Celery 브로커 충돌 방지)
REDIS_URL=redis://localhost:6379/0

# --- ClickHouse (주식 시계열 적재/조회) ---
# 완전 로컬: 8123 / 개발서버 사용: 터널 후 18123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DB=stock_data

# --- 인증(JWT) — 서비스 간 동일 값 필수 ---
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# --- 간편 로그인(카카오·네이버) — 키를 비우면 해당 버튼이 숨겨짐 ---
# 카카오: developers.kakao.com > 앱 > REST API 키 / (보안 > Client Secret 사용 시) 시크릿
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# (선택) 회원 탈퇴 시 카카오 연결 끊기 — 앱 > 앱 키 > Admin 키. 비면 생략(서버 전용, 노출 금지)
KAKAO_ADMIN_KEY=
# 네이버: developers.naver.com > 애플리케이션 > Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# state 서명 키(미설정 시 JWT_SECRET_KEY 폴백 — 운영은 별도 값 권장)
SOCIAL_STATE_SECRET=
# 공급자 콘솔 Redirect URI = {SOCIAL_REDIRECT_BASE}/{kakao|naver}/callback (기본 http://localhost:8001/api/v1/auth/social)
SOCIAL_REDIRECT_BASE=
# 로그인 후 복귀 주소(기본 http://localhost:3000/auth/complete · stockapp://auth · stockapp-dev://auth)
SOCIAL_WEB_RETURN_URL=
SOCIAL_APP_RETURN_URL_PROD=
SOCIAL_APP_RETURN_URL_DEV=
# true 면 실제 공급자 대신 가짜 공급자(로컬 스모크용). APP_ENV 가 명시적으로 development|test 일 때만 유효(그 외·미설정은 무시)
SOCIAL_FAKE_PROVIDER=

# --- 닉네임 게스트 로그인 게이트(POST /api/v1/auth/guest) ---
# true/false 명시 시 그 값. 비우면 APP_ENV 가 development|test 일 때만 허용(그 외 404). 개발 서버(develop)는 true
AUTH_GUEST_ENABLED=

# --- 차트 퀴즈 정기 생성(celery beat 21:00) — 미시도 문제 수 < MIN 이면 BATCH 개 생성(비우면 100/50) ---
QUIZ_POOL_MIN_UNSEEN=
QUIZ_POOL_BATCH=

# --- 관리자 시드 계정 ---
ADMIN_EMAIL=admin@stock.app
ADMIN_PASSWORD=admin1234

# --- CORS 추가 오리진(콤마 구분, 선택) ---
CORS_ORIGINS=

# --- 푸시(FCM) ---
PUSH_BACKEND=mock
# FCM_CREDENTIALS_PATH=./secrets/fcm-service-account.json

# ─────────────────────────────────────────────────────────────
# 한국투자증권(KIS) OpenAPI  ※ Phase 1 데이터 파이프라인용
#   앱키 발급: https://apiportal.koreainvestment.com  (모의투자 계좌로 먼저 발급 권장)
#   비워두면 수집기는 Mock 데이터로 폴백합니다.
# ─────────────────────────────────────────────────────────────
# KIS_MODE: vps=모의투자(sandbox) | prod=실서버
KIS_MODE=vps
# 발급받은 App Key (모의투자 계좌 기준 보통 36자)
KIS_APP_KEY=
# 발급받은 App Secret (보통 180자)
KIS_APP_SECRET=
# 계좌번호(예: 12345678-01). 시세조회만 쓰면 비워둡니다.
KIS_ACCOUNT_NO=
