{
  "env": {
    "ECC_DISABLED_HOOKS": "stop:format-typecheck,stop:check-console-log"
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.development)",
      "Read(./**/.env.development.local)",
      "Read(./**/.env.production)",
      "Read(./mobile/secrets/**)",
      "Edit(./**/.env.production)",
      "Edit(./mobile/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.mjs\"", "timeout": 90 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_on_stop.mjs\"", "timeout": 900 }
        ]
      }
    ]
  }
}
