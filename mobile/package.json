{
  "name": "mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env APP_ENV=development expo start",
    "start:prod": "cross-env APP_ENV=production expo start",
    "web": "expo start --web",
    "prebuild:dev": "cross-env APP_ENV=development expo prebuild --clean",
    "prebuild:prod": "cross-env APP_ENV=production expo prebuild --clean",
    "prebuild:dev:ios": "cross-env APP_ENV=development expo prebuild --platform ios --clean",
    "prebuild:dev:android": "cross-env APP_ENV=development expo prebuild --platform android --clean",
    "prebuild:prod:ios": "cross-env APP_ENV=production expo prebuild --platform ios --clean",
    "prebuild:prod:android": "cross-env APP_ENV=production expo prebuild --platform android --clean",
    "ios": "expo run:ios",
    "ios:dev": "cross-env APP_ENV=development expo run:ios",
    "ios:dev:device": "cross-env APP_ENV=development expo run:ios --device",
    "ios:prod": "npm run prebuild:prod:ios && cross-env APP_ENV=production expo run:ios --configuration Release --device",
    "android": "expo run:android",
    "android:dev": "cross-env APP_ENV=development expo run:android",
    "android:dev:device": "cross-env APP_ENV=development expo run:android --device",
    "android:prod": "npm run prebuild:prod:android && cross-env APP_ENV=production expo run:android --variant release --device",
    "build:ios:dev": "eas build --platform ios --profile development --local",
    "build:ios:sim": "eas build --platform ios --profile development-sim --local",
    "build:ios:prod": "eas build --platform ios --profile production --local",
    "build:android:dev": "eas build --platform android --profile development --local",
    "build:android:prod": "eas build --platform android --profile production --local",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "private": true
}
