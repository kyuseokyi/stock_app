{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // WebView 페이지 스크립트는 DOM·웹 설치본 타입으로 따로 검사(src/features/game/chart-web/page/tsconfig.json)
  "exclude": ["node_modules", "src/features/game/chart-web/page"]
}
