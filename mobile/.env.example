# 이 파일을 복사해 실제 환경파일을 만드세요(루트 .gitignore가 .env.* 를 무시하므로 example만 커밋됨).
#   cp .env.example .env.development   # 로컬 개발(아래 localhost 값 그대로)
#   cp .env.example .env.production    # 상용 — 아래 [운영] 도메인으로 교체
#
# EXPO_PUBLIC_ 접두사 변수는 앱 번들에 인라인된다(비밀값 금지).
# MSA라 서비스별 base URL이 분리돼 있다.
#   - 개발: 서비스별 포트(stock 8002 / blog 8000 / auth 8001). 실기기 테스트 시 localhost→개발 PC LAN IP.
#   - [운영]: Cloudflare Tunnel이 서비스별 서브도메인으로 라우팅(docs/deployment_guide.md)
#       EXPO_PUBLIC_STOCK_GRAPHQL_URL=https://api.haezean.com/graphql
#       EXPO_PUBLIC_BLOG_API_URL=https://blog.haezean.com
#       EXPO_PUBLIC_AUTH_API_URL=https://auth.haezean.com
#       EXPO_PUBLIC_GAME_API_URL=(trading_game 운영 배포 후 지정 — 미설정이면 게임 탭 "준비 중")
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_STOCK_GRAPHQL_URL=http://localhost:8002/graphql
EXPO_PUBLIC_BLOG_API_URL=http://localhost:8000
EXPO_PUBLIC_AUTH_API_URL=http://localhost:8001
# 트레이딩 게임(trading_game :8003) REST·WS — 선택. dev 미설정 시 http://localhost:8003
EXPO_PUBLIC_GAME_API_URL=http://localhost:8003

# 닉네임(게스트) 로그인 노출 — 개발용. 'true'/'false', 미설정이면 production 이 아닐 때만 노출
EXPO_PUBLIC_ENABLE_GUEST_LOGIN=

# 펀드 히스토리 Google Drive 백업 — Google Cloud OAuth "웹 애플리케이션" 클라이언트 ID(공개값). 비우면 백업 기능 숨김.
# 설정 절차: 루트 README '펀드 히스토리 · Google Drive 백업'
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── 푸시(빌드 시 app.config.js 가 읽음, EXPO_PUBLIC_ 아님) ──
# 선택 — 기본값은 app.config.js(DEFAULT_EAS_PROJECT_ID), 덮어쓸 때만 설정.
# EAS_PROJECT_ID=
# 선택 — mobile/secrets/google-services.json 이 있으면 자동 사용, 다른 경로로 덮어쓸 때만 설정(커밋 금지).
# GOOGLE_SERVICES_JSON=./secrets/google-services.json
