<?xml version="1.0" encoding="UTF-8"?>
<!--
  개발 서버(Mac mini) PG 매일 백업 — launchd 사용자 에이전트.
  __REPO__ 는 설치할 때 러너 폴더 경로로 바꾼다(docs/deploy/single-node-swarm.md 10절).
  매일 04:30 실행 — 수집·배포 시간대(16:00~21:30)를 피한다. 잠자기 중이었으면 깨어난 뒤 한 번 실행된다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockapp.pg-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/dev/pg-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/stockapp-pg-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/stockapp-pg-backup.log</string>
</dict>
</plist>
